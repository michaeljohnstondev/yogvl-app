{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/theyo",
        "destination": "/theyo.html"
      },
      {
        "source": "/theyo/join",
        "destination": "/theyo.html"
      }
    ]
  },
  "react-native": {
    "messaging_ios_foreground_presentation_options": ["badge", "sound", "banner", "list"]
  }
}