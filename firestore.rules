rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================================================
    // NOTIFICATION SECURITY RULES
    // ===========================================================================

    // User notifications subcollection - only user can read/write their own notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Validate notification data structure on write
      allow write: if request.auth != null
        && request.auth.uid == userId
        && validateNotificationData(resource.data);
    }

    // ===========================================================================
    // USER-SCOPED REMINDER COLLECTIONS
    // ===========================================================================

    // User reminders subcollection - only user can access their own reminders
    match /users/{userId}/reminders/{reminderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Validate reminder data structure on write
      allow write: if request.auth != null
        && request.auth.uid == userId
        && validateReminderData(request.resource.data);

      // Server-side access for Cloud Functions (reminder processing)
      allow read, write: if request.auth != null && isServerRequest();
    }

    // User scheduled notifications subcollection
    match /users/{userId}/scheduledNotifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Server-side processing access
      allow read, write: if request.auth != null && isServerRequest();
    }

    // ===========================================================================
    // USER DOCUMENT RULES
    // ===========================================================================

    // Users can read and write their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow reading basic user info for other users (for notifications, profiles, etc.)
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      // Validate device info updates (FCM tokens, notification settings)
      allow update: if request.auth != null
        && request.auth.uid == userId
        && validateDeviceInfoUpdate(resource.data, request.resource.data);
    }

    // ===========================================================================
    // STUDIO AND EVENT RULES
    // ===========================================================================

    // Studios - basic read access for authenticated users
    match /studios/{studioId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // TODO: Add proper studio ownership validation

      // Events within studios
      match /events/{eventId} {
        allow read: if request.auth != null;

        // Event creators and cohosts can update
        allow write: if request.auth != null
          && (request.auth.uid == resource.data.createdBy
              || request.auth.uid in resource.data.cohosts);

        // Allow subscription/invitation array updates for authorized users
        allow update: if request.auth != null
          && validateEventArrayUpdate(resource.data, request.resource.data);
      }
    }

    // ===========================================================================
    // VALIDATION FUNCTIONS
    // ===========================================================================

    // Validate notification data structure and content
    function validateNotificationData(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'message', 'createdAt', 'read'])
        && data.title is string && data.title.size() <= 100
        && data.message is string && data.message.size() <= 500
        && data.type in ['event_join', 'event_leave', 'event_update', 'event_cancelled',
                        'event_reminder', 'invitation_received', 'follow_notification']
        && data.read is bool
        && data.createdAt is timestamp;
    }

    // Validate reminder data structure and security
    function validateReminderData(data) {
      return data.keys().hasAll(['eventId', 'reminderType', 'triggerType', 'status', 'createdAt'])
        // Basic field validation
        && data.eventId is string && data.eventId.size() > 0 && data.eventId.size() <= 100
        && data.reminderType in ['host', 'attendee']
        && data.triggerType in ['time_based', 'event_based']
        && data.status in ['pending', 'sent', 'failed', 'cancelled', 'expired']
        && data.createdAt is timestamp
        // Content length limits for security
        && (!('eventTitle' in data) || (data.eventTitle is string && data.eventTitle.size() <= 100))
        && (!('reminderContent' in data) || validateReminderContent(data.reminderContent))
        // Security: Prevent privilege escalation
        && (!('isHost' in data) || data.isHost is bool)
        && (!('userRole' in data) || data.userRole in ['host', 'cohost', 'attendee'])
        // Rate limiting fields
        && (!('retryCount' in data) || (data.retryCount is number && data.retryCount >= 0 && data.retryCount <= 5));
    }

    // Validate reminder content structure
    function validateReminderContent(content) {
      return content is map
        && content.keys().hasAll(['title', 'body'])
        && content.title is string && content.title.size() <= 100
        && content.body is string && content.body.size() <= 200;
    }

    // Validate device info updates (FCM tokens, notification preferences)
    function validateDeviceInfoUpdate(oldData, newData) {
      return
        // FCM token updates are allowed
        (!newData.diff(oldData).affectedKeys().hasAny(['deviceInfo.fcmToken',
                                                      'deviceInfo.platform',
                                                      'deviceInfo.lastTokenUpdate',
                                                      'deviceInfo.notificationsEnabled']))
        // Notification preference updates are allowed
        || (!newData.diff(oldData).affectedKeys().hasAny(['userdata.settings.notifications']))
        // No other fields should be modified in device info updates
        || newData.diff(oldData).affectedKeys().hasOnly(['deviceInfo', 'userdata.settings']);
    }

    // Validate event array updates (subscriptions, invitations, attendance)
    function validateEventArrayUpdate(oldData, newData) {
      let changedFields = newData.diff(oldData).affectedKeys();

      return
        // Allow subscription, invitation, and attendance array changes
        changedFields.hasOnly(['subscribers', 'invitations', 'attendance', 'attendanceCount'])
        // Ensure arrays contain only valid data structures
        && (('subscribers' in newData && newData.subscribers is list) || !('subscribers' in newData))
        && (('invitations' in newData && newData.invitations is list) || !('invitations' in newData))
        && (('attendance' in newData && newData.attendance is list) || !('attendance' in newData))
        // Prevent malicious array manipulation
        && (!('subscribers' in newData) || newData.subscribers.size() <= 1000)
        && (!('invitations' in newData) || newData.invitations.size() <= 1000)
        && (!('attendance' in newData) || newData.attendance.size() <= 1000)
        // Validate attendance array structure
        && (!('attendance' in newData) || validateAttendanceArray(newData.attendance));
    }

    // Validate attendance array structure
    function validateAttendanceArray(attendance) {
      return attendance.size() == 0 ||
        attendance[0].keys().hasAll(['userId', 'attended', 'markedBy', 'markedAt']);
    }

    // ===========================================================================
    // ADMIN FUNCTIONS (for system notifications)
    // ===========================================================================

    // Admin users can send system-wide notifications
    match /admin/notifications/{notificationId} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Check if user is admin (customize based on your admin system)
    function isAdmin(userId) {
      return exists(/databases/$(database)/documents/admin/users/$(userId));
    }

    // Check if request is from server (Cloud Functions)
    function isServerRequest() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    // ===========================================================================
    // DEFAULT DENY RULE
    // ===========================================================================

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}