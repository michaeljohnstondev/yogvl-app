rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================================================
    // NOTIFICATION SECURITY RULES
    // ===========================================================================

    // User notifications subcollection - only user can read/write their own notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;

      // Validate notification data structure on write
      allow write: if request.auth != null
        && request.auth.uid == userId
        && validateNotificationData(resource.data);
    }

    // ===========================================================================
    // USER-SCOPED REMINDER COLLECTIONS
    // ===========================================================================

    // User reminders subcollection - only user can access their own reminders
    match /users/{userId}/reminders/{reminderId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;

      // Validate reminder data structure on write
      allow write: if request.auth != null
        && request.auth.uid == userId
        && validateReminderData(request.resource.data);

      // Server-side access for Cloud Functions (reminder processing)
      allow read, write, delete: if request.auth != null && isServerRequest();
    }

    // User scheduled notifications subcollection
    match /users/{userId}/scheduledNotifications/{notificationId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;

      // Server-side processing access
      allow read, write, delete: if request.auth != null && isServerRequest();
    }

    // ===========================================================================
    // USER DOCUMENT RULES
    // ===========================================================================

    // Users can read and write their own documents
    match /users/{userId} {
      // Users can read their own documents
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can create their own document on signup (must not set isAdmin)
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('isAdmin' in request.resource.data);

      // Users can update their own documents BUT NOT the isAdmin field
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']);

      // Allow users to update their device info and notification settings
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceInfo', 'userdata']);

      // Users can delete their own documents
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Allow reading basic user info for other users (for notifications, profiles, etc.)
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      // Allow admins to update any fields
      allow update: if request.auth != null && isAdmin(request.auth.uid);

      // Allow authenticated users to update social metrics in other users' documents
      // This is needed for the follow/unfollow dual-write pattern
      allow update: if request.auth != null
        && onlyUpdatingSocialMetrics();

      // User favorites subcollection - only owner can modify
      match /favorites/{favoriteUserId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // User following subcollection - only owner can modify their own following list
      match /following/{followedUserId} {
        allow read: if request.auth != null;
        allow write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // User followers subcollection - others can write to say they're following you
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == followerId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // User friends subcollection - authenticated users can read to check friend status
      match /friends/{friendId} {
        allow read: if request.auth != null;
        allow write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Host ratings subcollection - users can read their own ratings
      match /hostRatings/{ratingId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && validateHostRating(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // User event templates subcollection - only owner can access their templates
      match /eventTemplates/{templateId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===========================================================================
    // STUDIO AND EVENT RULES
    // ===========================================================================

    // Studios - allow all authenticated users to read/write
    match /studios/{studioId} {
      allow read, write: if request.auth != null;

      // Events - allow creation if user is authenticated and is the creator
      match /events/{eventId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.createdBy == request.auth.uid;

        // Only host can delete event
        allow delete: if request.auth != null
          && resource.data.createdBy == request.auth.uid;

        // Host and cohosts can fully edit event details
        allow update: if request.auth != null
          && (resource.data.createdBy == request.auth.uid
              || request.auth.uid in resource.data.cohosts);

        // Users can join/leave events (update subscribers array)
        allow update: if request.auth != null
          && onlyUpdatingEventParticipation();

        // Users can subscribe/unsubscribe to message board notifications
        allow update: if request.auth != null
          && onlyUpdatingMessageBoardSubscription();

        // Host can complete events and mark attendance
        allow update: if request.auth != null
          && resource.data.createdBy == request.auth.uid
          && onlyUpdatingEventCompletion();
      }

      // Reports (admin subcollection) - users can create reports, only admins can read/update
      match /admin/{reportId} {
        // Any authenticated user can create a report
        allow create: if request.auth != null
          && request.resource.data.reportedBy == request.auth.uid
          && request.resource.data.type in ['user', 'event']
          && request.resource.data.status == 'pending';

        // Only admins can read and update reports
        allow read, update: if request.auth != null && isAdmin(request.auth.uid);
      }

      // Allow all other subcollections under studios (interests, venues, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ===========================================================================
    // VALIDATION FUNCTIONS
    // ===========================================================================

    // Helper function to check if update only touches social metrics
    function onlyUpdatingSocialMetrics() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasAny(['userdata'])
        && !changedKeys.hasAny(['uid', 'deviceInfo', 'preferences', 'userdata.contactInfo',
                                 'userdata.metadata', 'userdata.onboarding', 'userdata.settings']);
    }

    // Helper function to check if update only touches event participation (join/leave)
    function onlyUpdatingEventParticipation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['subscribers', 'subscriberCount', 'invitations']);
    }

    // Helper function to check if update only touches message board subscription fields
    function onlyUpdatingMessageBoardSubscription() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['messageBoardSubscribers', 'messageBoardMuted']);
    }

    // Helper function to check if update only touches event completion fields
    function onlyUpdatingEventCompletion() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasAny(['status', 'completedAt', 'completedBy', 'attendance', 'attended', 'noShows', 'trackAttendance'])
        && !changedKeys.hasAny(['title', 'description', 'dateTime', 'location', 'maxGuests', 'createdBy', 'cohosts']);
    }

    // Validate notification data structure and content
    function validateNotificationData(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'message', 'createdAt', 'read'])
        && data.title is string && data.title.size() <= 100
        && data.message is string && data.message.size() <= 500
        && data.type in ['event_join', 'event_leave', 'event_update', 'event_cancelled',
                        'event_reminder', 'invitation_received', 'follow_notification']
        && data.read is bool
        && data.createdAt is timestamp;
    }

    // Validate reminder data structure and security
    function validateReminderData(data) {
      return data.keys().hasAll(['eventId', 'reminderType', 'triggerType', 'status', 'createdAt'])
        // Basic field validation
        && data.eventId is string && data.eventId.size() > 0 && data.eventId.size() <= 100
        && data.reminderType in ['host', 'attendee']
        && data.triggerType in ['time_based', 'event_based']
        && data.status in ['pending', 'sent', 'failed', 'cancelled', 'expired']
        && data.createdAt is timestamp
        // Content length limits for security
        && (!('eventTitle' in data) || (data.eventTitle is string && data.eventTitle.size() <= 100))
        && (!('reminderContent' in data) || validateReminderContent(data.reminderContent))
        // Security: Prevent privilege escalation
        && (!('isHost' in data) || data.isHost is bool)
        && (!('userRole' in data) || data.userRole in ['host', 'cohost', 'attendee'])
        // Rate limiting fields
        && (!('retryCount' in data) || (data.retryCount is number && data.retryCount >= 0 && data.retryCount <= 5));
    }

    // Validate reminder content structure
    function validateReminderContent(content) {
      return content is map
        && content.keys().hasAll(['title', 'body'])
        && content.title is string && content.title.size() <= 100
        && content.body is string && content.body.size() <= 200;
    }

    // Validate device info updates (FCM tokens, notification preferences)
    function validateDeviceInfoUpdate(oldData, newData) {
      return
        // FCM token updates are allowed
        (!newData.diff(oldData).affectedKeys().hasAny(['deviceInfo.fcmToken',
                                                      'deviceInfo.platform',
                                                      'deviceInfo.lastTokenUpdate',
                                                      'deviceInfo.notificationsEnabled']))
        // Notification preference updates are allowed
        || (!newData.diff(oldData).affectedKeys().hasAny(['userdata.settings.notifications']))
        // No other fields should be modified in device info updates
        || newData.diff(oldData).affectedKeys().hasOnly(['deviceInfo', 'userdata.settings']);
    }

    // Validate event array updates (subscriptions, invitations, attendance)
    function validateEventArrayUpdate(oldData, newData) {
      let changedFields = newData.diff(oldData).affectedKeys();

      return
        // Allow subscription, invitation, and attendance array changes
        changedFields.hasOnly(['subscribers', 'invitations', 'attendance', 'attendanceCount'])
        // Ensure arrays contain only valid data structures
        && (('subscribers' in newData && newData.subscribers is list) || !('subscribers' in newData))
        && (('invitations' in newData && newData.invitations is list) || !('invitations' in newData))
        && (('attendance' in newData && newData.attendance is list) || !('attendance' in newData))
        // Prevent malicious array manipulation
        && (!('subscribers' in newData) || newData.subscribers.size() <= 1000)
        && (!('invitations' in newData) || newData.invitations.size() <= 1000)
        && (!('attendance' in newData) || newData.attendance.size() <= 1000)
        // Validate attendance array structure
        && (!('attendance' in newData) || validateAttendanceArray(newData.attendance));
    }

    // Validate attendance array structure
    function validateAttendanceArray(attendance) {
      return attendance.size() == 0 ||
        attendance[0].keys().hasAll(['userId', 'attended', 'markedBy', 'markedAt']);
    }

    // Validate event data structure on creation
    function validateEventData(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.createdBy is string
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('maxGuests' in data) || (data.maxGuests is number && data.maxGuests > 0 && data.maxGuests <= 10000))
        && (!('isPrivate' in data) || data.isPrivate is bool)
        && (!('subscribers' in data) || data.subscribers is list)
        && (!('cohosts' in data) || data.cohosts is list)
        && (!('invitations' in data) || data.invitations is list);
    }

    // Validate venue data structure
    function validateVenueData(data) {
      return data.keys().hasAll(['name', 'address', 'source', 'verified', 'isPublicVenue'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.address is string && data.address.size() > 0 && data.address.size() <= 500
        && data.source == 'google_place'
        && data.verified == true
        && data.isPublicVenue == true
        && (!('usageCount' in data) || data.usageCount is number);
    }

    // Validate host rating data structure
    function validateHostRating(data) {
      return data.keys().hasAll(['eventId', 'studioId', 'rating', 'raterId'])
        && data.eventId is string && data.eventId.size() > 0
        && data.studioId is string && data.studioId.size() > 0
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.raterId is string && data.raterId == request.auth.uid
        && data.createdAt is timestamp;
    }

    // ===========================================================================
    // ADMIN FUNCTIONS (for system notifications)
    // ===========================================================================

    // Admin users collection - ONLY backend can write, nobody can read
    match /admin/users/{userId} {
      allow read, write: if false; // Only backend/console can modify admin list
    }

    // Admin global messages - admins can write, all authenticated users can read active messages
    match /admin/{adminUserId}/messages/{messageId} {
      // Admins can create and manage their own messages
      allow create, update, delete: if request.auth != null
        && isAdmin(request.auth.uid)
        && request.auth.uid == adminUserId;

      // All authenticated users can read active messages (for global announcements)
      allow read: if request.auth != null && resource.data.active == true;

      // Admins can read all messages (including inactive ones)
      allow read: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Collection group rule for messages - needed for collectionGroup queries
    match /{path=**}/messages/{messageId} {
      // All authenticated users can read active messages
      allow read: if request.auth != null && resource.data.active == true;

      // Admins can read all messages
      allow read: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Admin users can send system-wide notifications
    match /admin/notifications/{notificationId} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Admin reports - only admins can read/write
    match /admin/reports/{document=**} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Scheduled notifications - only admins and server can manage
    match /scheduledNotifications/{notificationId} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
      allow read, write: if request.auth != null && isServerRequest();

      // Allow users to create their own scheduled notifications
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Allow users to read and update their own scheduled notifications
      allow read, update: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Check if user is admin by checking their user document field
    function isAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isAdmin == true;
    }

    // Check if request is from server (Cloud Functions)
    function isServerRequest() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    // ===========================================================================
    // MAILING LIST RULES
    // ===========================================================================

    // Allow anyone to add their email to mailing list (for website signup)
    match /mailingList/{emailDoc} {
      // Allow unauthenticated users to create new entries
      allow create: if validateMailingListEntry(request.resource.data);

      // Only allow reading/updating/deleting for authenticated admins
      allow read, update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Validate mailing list entry structure
    function validateMailingListEntry(data) {
      return data.keys().hasAll(['email', 'subscribedAt', 'source'])
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 100
        && data.email.matches('.*@.*\\..*') // Basic email format validation
        && data.subscribedAt is timestamp
        && data.source is string
        && data.source in ['website-join-page', 'app', 'event-qr', 'manual'];
    }

    // ===========================================================================
    // DEFAULT DENY RULE
    // ===========================================================================

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}