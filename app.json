{
  "expo": {
    "name": "bvs-app",
    "slug": "bvs-app",
    "version": "1.0.0",
    "scheme": "bvs-app",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "experiments": {
      "newArchEnabled": false
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D1050"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bigvibestudios.bvs",
      "googleServicesFile": "./GoogleService-Info.plist",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D1050"
      },
      "backgroundColor": "#2D1050",
      "package": "com.bigvibestudios.bvs",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_CONTACTS",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "@react-native-firebase/app"
      ],
      [
        "@react-native-firebase/messaging",
        {
          "android_notification_icon": "./assets/adaptive-icon.png",
          "android_notification_color": "#00D4FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos to set profile picture",
          "cameraPermission": "Allow access to camera to take profile picture"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "dynamic",
            "xcodeProps": {
              "SWIFT_VERSION": "5.10",
              "OTHER_SWIFT_FLAGS": "-enable-experimental-feature AccessLevelOnImport -enable-experimental-feature SendingArgsAndResults -enable-experimental-feature StrictConcurrency"
            }
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "c108b708-c480-4bd9-80ea-ee79dd8cf7b7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c108b708-c480-4bd9-80ea-ee79dd8cf7b7",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
