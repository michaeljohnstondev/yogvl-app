{
  "expo": {
    "name": "The Yo",
    "slug": "bvs-app",
    "version": "1.0.0",
    "scheme": "the-yo",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "description": "Community event management app - create, join, and manage local events with your studio.",
    "privacy": "public",
    "privacyPolicyUrl": "https://bigvibestudios.com/privacy",
    "experiments": {
      "newArchEnabled": false
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000814",
      "hideStatusBar": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bigvibestudios.bvs",
      "buildNumber": "13",
      "googleServicesFile": "./GoogleService-Info.plist",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby events and set event locations.",
        "NSCameraUsageDescription": "We need camera access to let you take photos for your profile and events.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to let you upload photos for your profile and events.",
        "NSContactsUsageDescription": "We need contacts access to help you invite friends to events."
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000814"
      },
      "backgroundColor": "#001020",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#000814",
        "hideStatusBar": true
      },
      "statusBar": {
        "backgroundColor": "#001020",
        "barStyle": "light-content"
      },
      "package": "com.bigvibestudios.bvs",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_CONTACTS",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "@react-native-firebase/app"
      ],
      [
        "@react-native-firebase/messaging",
        {
          "android_notification_icon": "./assets/notification-icon.png",
          "android_notification_color": "#00D4FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos to set profile picture",
          "cameraPermission": "Allow access to camera to take profile picture"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "13.4",
            "useFrameworks": "static"
          }
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c108b708-c480-4bd9-80ea-ee79dd8cf7b7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c108b708-c480-4bd9-80ea-ee79dd8cf7b7",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
